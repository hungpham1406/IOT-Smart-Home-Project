080015f0 <display_Time>:
void set_Year(uint8_t year) {
	uint8_t year_Temp = dec_To_Bcd(year);
	HAL_I2C_Mem_Write(&hi2c1, DS3231_ADDRESS, 0x05, 1, &year_Temp, 1, 1000);
}

